# Server
NODE_ENV=development
PORT=5050

# JWT
JWT_SECRET=your_jwt_secret_here

# GitHub API & Org Configuration
GITHUB_ACCESS_TOKEN=your_github_access_token
GITHUB_ORG_NAME=c2siorg
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# ==============================
# Front-end URLs (comma-separated for multiple origins, used in CORS)
# ==============================
FRONTEND_BASE_URL=http://localhost:4200,https://c2siorg.github.io

# ==============================
# Backend (used in verification email links)
# ==============================
BACKEND_BASE_URL=http://localhost:5050

# ==============================
# Email Service (Gmail / Nodemailer)
# ==============================
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

# MongoDB (uncomment when needed)
# MONGODB_URI=mongodb://localhost:27017/webiu

# Database (PostgreSQL URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/webiu
# DATABASE_SSL can be 'true' or 'false' (defaults to true if URL contains render.com or NODE_ENV is production)
DATABASE_SSL=false
# DATABASE_REJECT_UNAUTHORIZED can be 'true' or 'false' (defaults to false for render.com URLs to support self-signed certs, true otherwise)
# DATABASE_REJECT_UNAUTHORIZED=true

# Cache
CACHE_TTL_SECONDS=300

# Cookie Configuration
# COOKIE_SAMESITE can be 'lax', 'strict', or 'none'
COOKIE_SAMESITE=lax
# COOKIE_SECURE can be 'true' or 'false'
COOKIE_SECURE=false
